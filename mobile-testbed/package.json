{
  "name": "mobile-testbed",
  "version": "1.0.0",
  "description": "Ghost-GO Mobile Testbed - React Native Expo App",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
