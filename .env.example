# Ghost Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env files with real values

# =============================================================================
# ICE Configuration
# =============================================================================

# STUN servers for NAT traversal (comma-separated)
# Example: stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
GHOST_STUN_SERVERS=stun:stun.l.google.com:19302

# TURN servers for relay (optional, comma-separated)
# Format: turn:host:port
GHOST_TURN_SERVERS=

# TURN server credentials (required if TURN servers are specified)
GHOST_TURN_USERNAME=
GHOST_TURN_PASSWORD=

# ICE gathering timeout (default: 10s)
GHOST_ICE_GATHER_TIMEOUT=10s

# ICE connection timeout (default: 30s)
GHOST_ICE_CONNECTION_TIMEOUT=30s

# ICE keepalive interval (default: 15s)
GHOST_ICE_KEEPALIVE_INTERVAL=15s

# =============================================================================
# WireGuard Configuration
# =============================================================================

# WireGuard MTU (default: 1280)
GHOST_WG_MTU=1280

# WireGuard persistent keepalive (default: 25s)
GHOST_WG_KEEPALIVE=25s

# =============================================================================
# Logging
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: text, json
LOG_FORMAT=text

# =============================================================================
# Development
# =============================================================================

# Enable verbose logging
GHOST_VERBOSE=false
